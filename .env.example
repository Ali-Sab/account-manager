PORT=3000
NODE_ENV=development
DATA_DIR=./data

# Must be 64 random hex bytes in production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CSRF_SECRET=

# WebAuthn relying party — must match the server's domain/IP
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Account Manager

# Claude.ai MCP OAuth client
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Game Backlog web OAuth client (generated once, shared with the game backlog app)
GAMEBACKLOG_CLIENT_ID=
GAMEBACKLOG_CLIENT_SECRET=
GAMEBACKLOG_REDIRECT_URI=http://localhost:3000/auth/callback
