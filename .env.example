PORT=3011
# Max requests per IP per 15-minute window on auth/setup routes (default: 20).
# Raise this in development if you hit rate limits during testing.
RATE_LIMIT_MAX=100
NODE_ENV=development
DATA_DIR=./data

# The public URL your JWT tokens will be issued from (no trailing slash)
JWT_ISSUER=http://localhost:3011

# Must be a random string in production — generate with:
#   openssl rand -hex 32
CSRF_SECRET=

# WebAuthn relying party — must match the server's domain (no port, no protocol)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Account Manager


# ── SMTP (for password reset emails) ──────────────────────────────────────────
# Gmail example: create an App Password at myaccount.google.com/apppasswords
# Leave SMTP_HOST blank to disable email (password reset will silently no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if blank.
SMTP_FROM=
# TLS mode: "starttls" (default, port 587), "tls" (implicit TLS / port 465), "none" (dev only)
SMTP_TLS=starttls
